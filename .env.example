# ========== 基础 ==========
# 部署环境：personal / server / gpu（W1 仅使用 personal/server 的公共部分）
APP_ENV=production
# 随机密钥：生产部署务必修改，例如 openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-64-char-hex-string
# access / refresh 令牌有效期
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# 首次启动后是否开放注册（管理员可在后台修改）
OPEN_REGISTRATION=true
# 登录失败锁定阈值（同一 用户名+IP 在锁定窗口内失败次数）
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900

# ========== PostgreSQL 18 + pgvector ==========
POSTGRES_USER=aidoc
POSTGRES_PASSWORD=aidoc_local_pwd
POSTGRES_DB=ai_doc_lint
POSTGRES_HOST=db
POSTGRES_PORT=5432
# 测试库（容器内 pytest 使用，需由脚本创建）
POSTGRES_TEST_DB=ai_doc_lint_test

# ========== Valkey 9（Redis 协议兼容，Celery broker / 缓存 / 限流） ==========
VALKEY_HOST=cache
VALKEY_PORT=6379
VALKEY_DB=0
VALKEY_PASSWORD=

# ========== MinIO（S3 兼容对象存储，原始文件/批注产物） ==========
# Docker Hub 的 minio/minio 在部分网络下会被 registry 拒绝，默认走 Quay 官方镜像
MINIO_IMAGE=quay.io/minio/minio:latest
MINIO_ENDPOINT=storage:9000
MINIO_ACCESS_KEY=aidoc_minio
MINIO_SECRET_KEY=aidoc_minio_local_pwd
MINIO_BUCKET=documents
MINIO_SECURE=false

# ========== 外部大模型（BYOK，W2 起使用；只允许通过环境变量注入） ==========
# OpenAI 兼容协议：DeepSeek / 智谱GLM / 硅基流动 / Qwen 均可
LLM_PRIMARY_BASE_URL=
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
# Embedding（OpenAI 兼容，默认 bge-m3；留空时 W6 再配置）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
